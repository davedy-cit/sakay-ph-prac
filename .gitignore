```gitignore
# ── Secrets ────────────────────────────────────────────────────
# NEVER commit these. If one is ever committed, it is in the history
# forever — rotating the credential is the only real fix.
.env
.env.*
!.env.example
*.pem
*.key

# ── Python ─────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
*.egg-info/
dist/
build/

# ── Django ─────────────────────────────────────────────────────
*.log
db.sqlite3
db.sqlite3-journal
/media/
/staticfiles/
backend/staticfiles/

# ── Testing & coverage ─────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# ── Linting caches ─────────────────────────────────────────────
.ruff_cache/
.mypy_cache/

# ── Node / Vue ─────────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Editors ────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp

# ── OS ─────────────────────────────────────────────────────────
Thumbs.db
Desktop.ini
.DS_Store

# ── Docker ─────────────────────────────────────────────────────
# Named volumes live inside Docker, but a local bind-mount folder
# would land here if one is added later.
mysql_data/
redis_data/
```