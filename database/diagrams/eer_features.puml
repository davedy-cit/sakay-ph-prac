@startuml eer_features
' ============================================================
' Sakay.ph - EER Diagram, PART 2 of 2 (ADVANCED DESIGN)
' Money, Pakyawan share-ride, safety and trip lifecycle.
' Same tables and columns as eer_development.puml.
' USER, PASSENGER, DRIVER and RIDE appear here only as
' key-only reference stubs - their full definitions are in
' eer_core.puml.
' ============================================================
skinparam backgroundColor #FFFFFF
skinparam dpi 150
skinparam defaultFontName Segoe UI
skinparam linetype ortho
skinparam ArrowColor #2D6DA3
skinparam entity {
  BackgroundColor #EEF5FB
  BorderColor #1F4E79
  FontColor #222222
  FontSize 12
  AttributeFontSize 10
}
skinparam NoteBackgroundColor #FFF7EC
skinparam NoteBorderColor #E67E22
hide circle

title <b>Sakay.ph — EER Diagram, Part 2: Money, Pakyawan, Safety and Lifecycle</b>\n<size:12><color:#7A8AA0>Advanced design (2 of 2) — see eer_core.puml for people, vehicles and rides</color></size>

' ==================== REFERENCE STUBS (defined in eer_core) ====================
entity "USER" as user <<from core>> {
  * user_id : UUID <<PK>>
}

entity "PASSENGER" as pax <<from core>> {
  * passenger_id : UUID <<PK>>
}

entity "RIDE" as ride <<from core>> {
  * ride_id : UUID <<PK>>
}

entity "DRIVER" as drv <<from core>> {
  * driver_id : UUID <<PK>>
}

' ==================== LOOKUP ====================
entity "PAYMENT_METHOD" as pm {
  * method_code : VARCHAR(12) <<PK>>
  --
  * method_name : VARCHAR(30)
  * is_digital : BOOLEAN
  gateway_name : VARCHAR(30)
}

' ==================== MONEY ====================
entity "WALLET" as wallet {
  * wallet_id : UUID <<PK>>
  --
  * passenger_id : UUID <<FK, UQ>>
  * balance : DECIMAL(12,2)
  * currency : CHAR(3)
  * updated_at : DATETIME
}

entity "WALLET_TXN" as txn {
  * txn_id : UUID <<PK>>
  --
  * wallet_id : UUID <<FK>>
  payment_id : UUID <<FK>>
  * txn_type : VARCHAR(12)
  * amount : DECIMAL(10,2)
  * balance_after : DECIMAL(12,2)
  gateway_ref : VARCHAR(40)
  * created_at : DATETIME
}

entity "PAYMENT" as pay {
  * payment_id : UUID <<PK>>
  --
  * ride_id : UUID <<FK, UQ>>
  * payer_id : UUID <<FK>>
  * method_code : VARCHAR(12) <<FK>>
  wallet_id : UUID <<FK>>
  * amount : DECIMAL(10,2)
  gateway_ref : VARCHAR(40)
  * status : VARCHAR(16)
  * paid_at : DATETIME
}

entity "RECEIPT" as rcpt {
  * receipt_no : VARCHAR(20) <<PK>>
  --
  * payment_id : UUID <<FK, UQ>>
  * total_amount : DECIMAL(10,2)
  * issued_at : DATETIME
  receipt_url : VARCHAR(255)
}

entity "DRIVER_PAYOUT" as payout {
  * payout_id : UUID <<PK>>
  --
  * driver_id : UUID <<FK>>
  * method_code : VARCHAR(12) <<FK>>
  * amount : DECIMAL(10,2)
  gateway_ref : VARCHAR(40)
  * status : VARCHAR(12)
  * requested_at : DATETIME
  paid_at : DATETIME
}

' ==================== PAKYAWAN (SHARE-RIDE) ====================
entity "PAKYAWAN_GROUP" as grp {
  * group_id : UUID <<PK>>
  --
  * ride_id : UUID <<FK, UQ>>
  * direction : VARCHAR(120)
  * max_seats : SMALLINT
  * matched_seats : SMALLINT
  * group_status : VARCHAR(12)
}

entity "FARE_SHARE" as share {
  * payment_id : UUID <<PK, FK>>
  * passenger_id : UUID <<PK, FK>>
  --
  * group_id : UUID <<FK>>
  * passenger_count : SMALLINT
  * share_amount : DECIMAL(10,2)
  * is_paid : BOOLEAN
}

' ==================== SAFETY ====================
entity "SOS_ALERT" as sos {
  * alert_id : UUID <<PK>>
  --
  * ride_id : UUID <<FK, UQ>>
  * raised_by : UUID <<FK>>
  * alert_type : VARCHAR(20)
  * alert_lat : DECIMAL(9,6)
  * alert_long : DECIMAL(9,6)
  * status : VARCHAR(12)
  * triggered_at : DATETIME
  resolved_at : DATETIME
}

entity "TRUSTED_CONTACT" as tc {
  * contact_id : UUID <<PK>>
  --
  * passenger_id : UUID <<FK>>
  * contact_name : VARCHAR(120)
  * contact_mobile : VARCHAR(15)
  relationship : VARCHAR(30)
}

entity "SOS_NOTIFICATION" as sosn {
  * alert_id : UUID <<PK, FK>>
  * contact_id : UUID <<PK, FK>>
  --
  * notified_at : DATETIME
  * delivery_status : VARCHAR(12)
}

entity "TRIP_TRACKING" as track {
  * track_id : BIGINT <<PK>>
  --
  * ride_id : UUID <<FK>>
  * latitude : DECIMAL(9,6)
  * longitude : DECIMAL(9,6)
  * recorded_at : DATETIME
}

' ==================== LIFECYCLE ====================
entity "CANCELLATION" as cancel {
  * cancel_id : UUID <<PK>>
  --
  * ride_id : UUID <<FK, UQ>>
  * cancelled_by : UUID <<FK>>
  * reason_code : VARCHAR(20)
  * fee_amount : DECIMAL(10,2)
  * refund_amount : DECIMAL(10,2)
  * cancelled_at : DATETIME
}

entity "RATING" as rating {
  * rating_id : UUID <<PK>>
  --
  * ride_id : UUID <<FK>>
  * rater_user_id : UUID <<FK>>
  * ratee_user_id : UUID <<FK>>
  * stars : SMALLINT
  comment : VARCHAR(255)
  * rated_at : DATETIME
}

' ==================== RELATIONSHIPS ====================
pax    ||--o| wallet   : "owns"

wallet ||--o{ txn      : "logs"
pay    |o--o{ txn      : "settles"
pay    }o--o| wallet   : "charged to"
pm     ||--o{ pay      : "paid via"
ride   ||--o| pay      : "settled by"
pax    ||--o{ pay      : "pays"
pay    ||--o| rcpt     : "issues"

drv    ||--o{ payout   : "is paid by"
pm     ||--o{ payout   : "paid out via"

ride   ||--o| grp      : "may form"
grp    ||--o{ share    : "splits across"
pay    ||--o{ share    : "split into"
pax    ||--o{ share    : "owes"

ride   ||--o| sos      : "may raise"
sos    ||--o{ sosn     : "notifies"
tc     ||--o{ sosn     : "receives"
pax    ||--o{ tc       : "registers"
ride   ||--o{ track    : "tracked by"

ride   ||--o| cancel   : "may have"
user   ||--o{ cancel   : "cancels"
user   ||--o{ sos      : "raises"
ride   ||--o{ rating   : "receives"
user   ||--o{ rating   : "writes"
user   ||--o{ rating   : "is rated in"

legend bottom
  <b>Cardinality</b> — || mandatory one · }| mandatory many · }o optional many · |o optional one      <b>PK</b> primary key · <b>FK</b> foreign key · <b>UQ</b> unique
  <b>Associative entities</b> resolve M:N — FARE_SHARE (PAYMENT x PASSENGER) · SOS_NOTIFICATION (SOS_ALERT x TRUSTED_CONTACT)      <b>Unary / recursive</b> — RATING relates to USER twice
  <b>Money flow</b> — PAYMENT collects from the passenger; DRIVER_PAYOUT pays the driver's earnings out through PAYMENT_METHOD      <b>Bagyo Mode</b> — SURGE_PERIOD is in <b>eer_core.puml</b>
  <b>Reference stubs</b> — USER, PASSENGER, DRIVER and RIDE are drawn key-only here; their full column lists are in <b>eer_core.puml</b>.
end legend
@enduml
